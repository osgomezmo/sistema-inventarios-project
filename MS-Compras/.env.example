# Servidor HTTP
PORT=5000
FLASK_DEBUG=false

# Base de datos MySQL exclusiva de ms-compras
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=compras_user
DB_PASSWORD=changeme
DB_NAME=mscompras
DB_POOL_SIZE=5

# RabbitMQ (exchange tipo topic donde publica eventos de compras)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=inventario.eventos

# Comunicacion sincrona hacia ms-proveedores
PROVEEDORES_URL=http://127.0.0.1:3001
PROVEEDORES_TIMEOUT_SECONDS=3.0

# Seguridad entre servicios (Api-Gateway -> microservicios y ms -> ms)
SERVICE_TOKEN=changeme-service-token
