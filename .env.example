# ==============================================================================
# Configuracion de Despliegue Orquestado (docker-compose.yml raiz)
# ==============================================================================
# Puedes copiar este archivo a `.env` en la raiz para personalizar puertos o
# credenciales. Si no existe `.env`, docker-compose.yml usa valores seguros por
# defecto para todos los contenedores.

# Puerto publico donde responde la interfaz web (Nginx) en la VM
FRONTEND_PORT=80

# Token interno compartido entre el API Gateway y todos los microservicios
SERVICE_TOKEN=token-servicio-inventarios-2026-vm

# Sembrado automatico de datos iniciales al primer arranque (1 = si, 0 = no)
SEMBRAR_DATOS=1

# Credenciales del Broker RabbitMQ
RABBITMQ_USER=inventario
RABBITMQ_PASSWORD=inventario_secret

# Base de datos MySQL exclusiva de API Gateway
GATEWAY_DB_NAME=gateway
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=gateway_secret_2026
GATEWAY_APP_KEY=base64:MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# Usuarios iniciales sembrados en API Gateway
ADMIN_EMAIL=admin@inventario.local
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=Inventario2026
USUARIOS_INICIALES_PASSWORD=Inventario2026

# Base de datos MySQL exclusiva de MS-Productos
PRODUCTOS_DB_NAME=ms_productos
PRODUCTOS_DB_USER=ms_productos
PRODUCTOS_DB_PASSWORD=productos_secret_2026

# Base de datos MySQL exclusiva de MS-Inventario
INVENTARIO_DB_NAME=ms_inventario
INVENTARIO_DB_USER=ms_inventario
INVENTARIO_DB_PASSWORD=inventario_secret_2026

# Base de datos MySQL exclusiva de MS-Proveedores
PROVEEDORES_DB_NAME=proveedores
PROVEEDORES_DB_USER=proveedores_user
PROVEEDORES_DB_PASSWORD=proveedores_secret_2026

# Base de datos MySQL exclusiva de MS-Compras
COMPRAS_DB_NAME=mscompras
COMPRAS_DB_USER=compras_user
COMPRAS_DB_PASSWORD=compras_secret_2026

# Configuracion de MS-Notificaciones (local / firestore)
NOTIFICACIONES_STORAGE_DRIVER=local
NOTIFICACIONES_PUSH_DRIVER=console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
